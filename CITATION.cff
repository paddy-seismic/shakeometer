    given-names: Patrick
    email: Patrick.Smith@dias.ie
    affiliation: "Dublin Institute for Advanced Studies (DIAS); Irish National Seismic Network (INSN)"
    orcid: "https://orcid.org/0000-0003-1460-8984"
license: EUPL-1.2
repository-code: "https://git.dias.ie/paddy/shakeometer"
keywords:
  - seismology
  - outreach
  - local magnitude
  - real-time
  - SeedLink
  - Raspberry Shake
  - ObsPy
